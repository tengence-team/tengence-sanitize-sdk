{
  "name": "tengence-sanitize-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "tengence 本地脱敏前置工具仓库：明文不出用户环境，本地字段级脱敏后调用批量推送接口",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @tengence/sanitize-sdk && npm run build -w @tengence/sanitize-cli",
    "test": "npm run test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tengence-team/tengence-sanitize-sdk.git"
  },
  "homepage": "https://github.com/tengence-team/tengence-sanitize-sdk",
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
