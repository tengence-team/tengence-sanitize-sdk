{
  "version": 1,
  "rules": [
    {
      "fields": [
        "id"
      ],
      "method": "preserve"
    },
    {
      "fields": [
        "phone"
      ],
      "method": "hash",
      "params": {
        "algorithm": "SHA-256",
        "saltEnv": "TENGENCE_SANITIZE_SALT"
      }
    },
    {
      "fields": [
        "user_id"
      ],
      "method": "hash",
      "params": {
        "algorithm": "HMAC-SHA-256",
        "keyEnv": "TENGENCE_SANITIZE_KEY",
        "hashLength": 64
      }
    },
    {
      "fields": [
        "name"
      ],
      "method": "hash",
      "params": {
        "algorithm": "SHA-256",
        "saltEnv": "TENGENCE_SANITIZE_SALT"
      }
    },
    {
      "fields": [
        "id_card"
      ],
      "method": "mask",
      "params": {
        "keepFirst": 4,
        "keepLast": 4
      }
    },
    {
      "fields": [
        "order_no"
      ],
      "method": "encrypt",
      "params": {
        "keyEnv": "TENGENCE_SANITIZE_KEY"
      }
    },
    {
      "fields": [
        "contact_phone"
      ],
      "method": "hash",
      "params": {
        "algorithm": "SHA-256",
        "saltEnv": "TENGENCE_SANITIZE_SALT"
      }
    },
    {
      "fields": [
        "remark"
      ],
      "method": "preserve"
    }
  ],
  "upload": {
    "pushUrl": "https://api.mossego.com/v1/push/data",
    "apiKeyEnv": "TENGENCE_API_KEY",
    "batchSize": 1000,
    "maxRetries": 3,
    "timeoutMs": 30000
  },
  "audit": {
    "enabled": true,
    "dir": "./.tengence-sanitize-audit"
  }
}